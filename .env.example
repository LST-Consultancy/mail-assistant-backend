# Copy to .env (git-ignored). Read by npm run dev.

# ---- AI provider (OpenAI) ----
# Key from https://platform.openai.com/api-keys
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Parallel AI calls per digest batch.
LLM_CONCURRENCY=5
# Application (client) ID of the single Entra app registration (SPA + exposed API).
ENTRA_CLIENT_ID=
# Not used for validation (authority is "common"); kept for docs/tooling.
ENTRA_TENANT_ID=common
# Comma-separated. Single tenant + personal Outlook.com accounts:
#   <your-tenant-id>,9188040d-6c67-4c5b-b112-36a304b66dad
# Empty = any tenant (not recommended).
ALLOWED_TENANT_IDS=
# Comma-separated origins allowed by CORS.
ADDIN_ORIGIN=https://localhost:3000
PORT=8080
DAILY_TOKEN_BUDGET_PER_USER=500000
REQUESTS_PER_MINUTE=60
MAX_BODY_CHARS=6000
# Local HTTPS for the backend (reuse office-addin-dev-certs). Leave empty in production.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Dev only: accept the literal bearer token "dev" (used by VITE_MOCK=1). Ignored when NODE_ENV=production.
DEV_AUTH_BYPASS=


# ---- Deployment (VPS, docker compose behind the existing Traefik) ----
# Public hostname of this API (only /api/* is routed here, so it can be the add-in's host).
API_HOST=
# Copy these three from the running Traefik (see deployment guide, step 1).
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=
TRAEFIK_CERTRESOLVER=
